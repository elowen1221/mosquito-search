# GitHub 访问令牌（可选）：存在时使用认证请求，缺失时匿名访问并输出 warning
GITHUB_TOKEN=

# Embedding 模型（可选）：默认 BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# BERT Cross-Encoder 模型路径（可选）：如果设置且模型存在，bert ranking 自动启用
# 不设置时 bert 模式返回 503 "bert ranker 未启用"
# 可以是 HuggingFace 模型名（首次启动会下载）或本地训练后的目录
BERT_MODEL_PATH=

# 服务绑定地址（生产必须绑定 127.0.0.1，由反向代理负责 HTTPS）
MOSQUITO_HOST=127.0.0.1
MOSQUITO_PORT=8000